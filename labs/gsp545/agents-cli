#!/usr/bin/env python3
"""
Agents CLI (agents-cli) - Tooling for Google Antigravity & Agent Workflows.
Provides governance, schema validation, and distribution packaging for custom skills.

Usage:
  agents-cli skill validate <SKILL_PATH>
  agents-cli package --skill <SKILL_NAME> --output-dir <OUTPUT_DIR>
"""

import sys
import os
import re
import json
import tarfile
import hashlib
import argparse
from datetime import datetime

try:
    import yaml
    HAS_YAML = True
except ImportError:
    HAS_YAML = False


def parse_frontmatter(content):
    """Parses YAML frontmatter enclosed in --- delimiters."""
    pattern = r"^---\s*\n(.*?)\n---\s*\n(.*)$"
    match = re.search(pattern, content, re.DOTALL)
    if not match:
        return None, content

    frontmatter_raw = match.group(1)
    body = match.group(2)

    if HAS_YAML:
        try:
            data = yaml.safe_load(frontmatter_raw)
            return data, body
        except Exception:
            pass

    # Fallback parser if PyYAML is not installed or syntax differs
    data = {}
    for line in frontmatter_raw.splitlines():
        line = line.strip()
        if ":" in line and not line.startswith("#"):
            k, v = line.split(":", 1)
            data[k.strip()] = v.strip().strip("'\"")
    return data, body


def validate_skill(skill_path):
    """Validates skill structure and schema compliance."""
    print(f"Validating skill at: {skill_path}")

    target_file = skill_path
    if os.path.isdir(skill_path):
        target_file = os.path.join(skill_path, "SKILL.md")

    if not os.path.exists(target_file):
        print(f"ERROR: Target skill file not found: {target_file}")
        return False, None

    with open(target_file, "r", encoding="utf-8") as f:
        content = f.read()

    frontmatter, body = parse_frontmatter(content)
    if not frontmatter or not isinstance(frontmatter, dict):
        print("ERROR: Skill file missing valid YAML frontmatter enclosed by '---'.")
        return False, None

    skill_name = frontmatter.get("name")
    description = frontmatter.get("description")

    if not skill_name:
        print("ERROR: Missing required frontmatter field: 'name'")
        return False, None

    if not description:
        print("ERROR: Missing required frontmatter field: 'description'")
        return False, None

    if len(body.strip()) < 30:
        print("ERROR: Skill instructions body is too short or empty (minimum 30 characters required).")
        return False, None

    print(f"  [OK] Valid YAML frontmatter detected.")
    print(f"  [OK] Skill Name: {skill_name}")
    print(f"  [OK] Description: {description}")
    print(f"  [OK] Instruction body length: {len(body.strip())} characters.")
    print("SUCCESS: Skill schema validation passed (0 errors, 0 warnings).")
    return True, (frontmatter, target_file)


def package_skill(skill_name, output_dir):
    """Bundles validated skill into an enterprise distribution archive."""
    print(f"Packaging skill: '{skill_name}' into directory: '{output_dir}'")

    # Search paths for skill
    possible_paths = [
        os.path.expanduser(f"~/.gemini/skills/{skill_name}"),
        os.path.join(os.getcwd(), f"skills/{skill_name}"),
        os.path.join(os.getcwd(), skill_name),
        os.path.expanduser(f"~/.gemini/skills/{skill_name}/SKILL.md"),
    ]

    skill_dir = None
    skill_file = None
    for p in possible_paths:
        if os.path.isdir(p) and os.path.exists(os.path.join(p, "SKILL.md")):
            skill_dir = p
            skill_file = os.path.join(p, "SKILL.md")
            break
        elif os.path.isfile(p):
            skill_file = p
            skill_dir = os.path.dirname(p)
            break

    if not skill_file or not os.path.exists(skill_file):
        print(f"ERROR: Could not locate skill '{skill_name}' in standard search paths (~/.gemini/skills/).")
        return False

    valid, result = validate_skill(skill_file)
    if not valid:
        print(f"ERROR: Skill '{skill_name}' failed validation. Packaging aborted.")
        return False

    frontmatter, _ = result
    os.makedirs(output_dir, exist_ok=True)

    with open(skill_file, "rb") as f:
        file_hash = hashlib.sha256(f.read()).hexdigest()

    manifest = {
        "manifest_version": "1.0.0",
        "name": frontmatter.get("name", skill_name),
        "description": frontmatter.get("description", ""),
        "packaged_at": datetime.utcnow().isoformat() + "Z",
        "checksum_sha256": file_hash,
        "files": ["SKILL.md"]
    }

    manifest_path = os.path.join(output_dir, "skill-manifest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)
    print(f"  [OK] Generated manifest: {manifest_path}")

    clean_name = frontmatter.get("name") or os.path.basename(skill_name.rstrip("/\\"))
    archive_path = os.path.join(output_dir, f"{clean_name}.tar.gz")
    with tarfile.open(archive_path, "w:gz") as tar:
        tar.add(skill_file, arcname="SKILL.md")
        tar.add(manifest_path, arcname="skill-manifest.json")
    print(f"  [OK] Created distribution archive: {archive_path}")

    print(f"SUCCESS: Skill '{skill_name}' packaged successfully for enterprise deployment.")
    return True


def main():
    parser = argparse.ArgumentParser(prog="agents-cli", description="Google Antigravity & Agentic Workflow CLI")
    subparsers = parser.add_subparsers(dest="command")

    # agents-cli skill validate <PATH>
    skill_parser = subparsers.add_parser("skill", help="Manage and validate skills")
    skill_subparsers = skill_parser.add_subparsers(dest="skill_action")
    val_parser = skill_subparsers.add_parser("validate", help="Validate a skill's schema and structure")
    val_parser.add_argument("path", help="Path to SKILL.md or skill directory")

    # agents-cli package --skill <NAME> --output-dir <DIR>
    pkg_parser = subparsers.add_parser("package", help="Package skills for enterprise deployment")
    pkg_parser.add_argument("--skill", required=True, help="Name or path of skill to package")
    pkg_parser.add_argument("--output-dir", default="dist", help="Output directory for packaged assets")

    args = parser.parse_args()

    if args.command == "skill":
        if args.skill_action == "validate":
            success, _ = validate_skill(args.path)
            sys.exit(0 if success else 1)
        else:
            skill_parser.print_help()
            sys.exit(1)
    elif args.command == "package":
        success = package_skill(args.skill, args.output_dir)
        sys.exit(0 if success else 1)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
